generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  slackId    String   @id
  quests     Quests[]

  tutorial_stage Stage @default(INITIALIZED)
  mpimId     String
}

enum Stage {
  INITIALIZED
  OPEN_LID
  SHOW_COC
  ACCEPTED_COC
  SLACK_TUTORIAL
  FINISHED
}

model Quests {
  uid        String   @id @default(uuid())
  questId    String   

  progress   Float      @default(0) 
  completed  Boolean    @default(false)

  slackId    String
  user       User     @relation(fields: [slackId], references: [slackId])

  lastUpdated DateTime? @updatedAt
  dateCompleted DateTime?

  metadata   Json?
}